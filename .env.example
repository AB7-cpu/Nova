# ==============================================================================
# Nova Voice Assistant — Environment Configuration
# ==============================================================================
# Copy this file to .env and populate your respective API keys:
#   cp .env.example .env

# Groq Cloud API Key (Primary Online LLM Provider)
# https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Tavily Search API Key (Used by SearchAgent for live web research)
# https://app.tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Google Gemini API Key (Secondary/Fallback Online LLM Provider)
# https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Local Ollama Server Base URL (Defaults to http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Kokoro TTS via Local Voicebox HTTP Endpoint (Defaults to http://127.0.0.1:17493/generate/stream)
VOICEBOX_URL=http://127.0.0.1:17493/generate/stream
VOICEBOX_PROFILE_ID=a441e093-3f50-491d-b764-532040510eb3

# VibeVoice TTS WebSocket Server (Alternative Local TTS engine)
VIBESVOICE_URI=ws://localhost:3000

# Optional: WLED Hardware Feedback IP Address(for system agent which is to be implemented)
WLED_IP=192.168.1.20
